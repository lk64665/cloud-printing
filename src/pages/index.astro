---
import AppHeader from '../components/AppHeader.astro'
import AppFooter from '../components/AppFooter.astro'
import TabNav from '../components/TabNav'
import SharePrinterPanel from '../components/SharePrinterPanel'
import PrintFilePanel from '../components/PrintFilePanel'
import '../styles/global.css'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>printer kiosk — easy remote printing</title>
    <meta name="description" content="easy remote printing" />

    <meta property="og:url" content="https://printer kiosk/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="printer kiosk" />
    <meta property="og:description" content="easy remote printing" />
    <meta property="og:image" content="https://printer kiosk/opengraph.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="printer kiosk" />
    <meta name="twitter:description" content="easy remote printing" />
    <meta name="twitter:image" content="https://printer kiosk/opengraph.png" />

    <meta name="theme-color" content="#f9f8f6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="printer kiosk" />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
  </head>
  <body>
    <main>
      <AppHeader />

      <TabNav client:only="preact" />

      <div class="panels">
        <SharePrinterPanel client:only="preact" />
        <PrintFilePanel client:only="preact" />
      </div>
    </main>

    <AppFooter />

    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register(`${base}/sw.js`)
      }
    </script>

  </body>
</html>
